# Port HTTP untuk halaman TV dan /api/state
PORT=3000
# Interval baca ulang sumber data (ms, minimal 5000)
POLL_MS=30000
# Sumber yang dipakai, dipisah koma: postgres, sheet, jubelio
DATA_SOURCES=postgres,sheet,jubelio
# Netlify saja: lama /api/state di-cache di CDN (detik)
CACHE_SECONDS=15

# --- Postgres ---
DATABASE_URL=postgres://imperfect:imperfect@localhost:5432/imperfect
# Query harus mengembalikan kolom: phone, name, qty, value (satu baris per transaksi)
# PG_QUERY=SELECT no_hp AS phone, nama AS name, jumlah AS qty, total AS value FROM penjualan WHERE event = 'imperfect-2026'
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

# --- Google Sheet ---
# Link Sheet (Share: Anyone with the link, Viewer), ID Sheet, atau link CSV dari Publish to web
SHEET_URL=https://docs.google.com/spreadsheets/d/1PxiUbW5nFohIkVMae8m2yd-OWzrqOcwSavEv8In6Uok/edit?gid=949297504#gid=949297504
SHEET_GID=949297504

# --- Jubelio (hanya baca: POST /login + GET) ---
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
# Nama gudang/lokasi di Jubelio (boleh beberapa, dipisah koma), atau pakai JUBELIO_LOCATION_ID
JUBELIO_LOCATION=Imperfect Sales 2025
# JUBELIO_LOCATION_ID=
# Rentang tanggal transaksi event (WIB). Wajib diisi agar tidak menarik semua order sejak 2023
JUBELIO_DATE_FROM=
# JUBELIO_DATE_TO=
# Kolom nilai belanja dari detail order: grand_total (default) atau sub_total
# JUBELIO_VALUE_FIELD=grand_total
# JUBELIO_INCLUDE_CANCELED=false
# JUBELIO_CONCURRENCY=5
