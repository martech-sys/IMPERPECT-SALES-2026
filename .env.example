# Port HTTP untuk halaman TV dan /api/state
PORT=3000
# Interval baca ulang sumber data (ms, minimal 5000)
POLL_MS=30000
# Sumber yang dipakai, dipisah koma: postgres, sheet, jubelio
# Event 2026: data dari warehouse we_data_store (laporan_penjualan)
DATA_SOURCES=postgres
# Netlify saja: lama /api/state di-cache di CDN (detik)
CACHE_SECONDS=15

# --- Postgres: warehouse we_data_store, tabel laporan_penjualan ---
# Pakai user read-only. Password dengan tanda baca harus di-URL-encode (# -> %23, / -> %2F).
# Kalau tabelnya di schema lain, tambahkan ?options=-c%20search_path%3Dnama_schema
DATABASE_URL=postgres://readonly:password@host:5432/we_data_store
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Satu baris per invoice: phone, name, qty, value. laporan_penjualan berisi satu baris
# per produk, jadi dijumlahkan per invoice. Nilai = total_harga_barang (bukan total_bayar,
# yang berulang di tiap baris produk). Kolom penyaring event (warehouse atau channel) dan
# status yang dibuang dipastikan dulu dengan scripts/cek-event-postgres.sql.
PG_QUERY=SELECT no_hp AS phone, MAX(nama) AS name, SUM(qty) AS qty, SUM(total_harga_barang) AS value FROM laporan_penjualan WHERE warehouse = 'MAIN IMPERFECT WAREHOUS 2026' AND tanggal >= DATE '2026-10-30' AND tanggal < DATE '2026-11-02' GROUP BY COALESCE(NULLIF(btrim(invoice_number), ''), no_order), no_hp

# --- Google Sheet ---
# Link Sheet (Share: Anyone with the link, Viewer), ID Sheet, atau link CSV dari Publish to web
SHEET_URL=https://docs.google.com/spreadsheets/d/1PxiUbW5nFohIkVMae8m2yd-OWzrqOcwSavEv8In6Uok/edit?gid=949297504#gid=949297504
SHEET_GID=949297504

# --- Jubelio (hanya baca: POST /login + GET) ---
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
# Boleh beberapa gudang, dipisah koma
# Event 2026 (live). Nama gudang PERSIS seperti di Jubelio (huruf besar/kecil bebas).
# Daftar order Jubelio hanya memuat nama lokasi, jadi filter selalu lewat nama.
JUBELIO_LOCATION=MAIN IMPERFECT WAREHOUS 2026
# Rentang tanggal transaksi event (WIB). Wajib diisi agar tidak menarik semua order sejak 2023
JUBELIO_DATE_FROM=2026-10-30
JUBELIO_DATE_TO=2026-11-01
# Kolom nilai belanja dari detail order: grand_total (default) atau sub_total
# JUBELIO_VALUE_FIELD=grand_total
# JUBELIO_INCLUDE_CANCELED=false
# JUBELIO_CONCURRENCY=5
# Batas waktu sinkron per pembacaan (ms). Server Node 20000; Netlify Function 7000
# JUBELIO_BUDGET_MS=20000
