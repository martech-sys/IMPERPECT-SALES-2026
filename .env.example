# Port HTTP untuk halaman TV dan /api/state
PORT=3000
# Interval baca ulang sumber data (ms, minimal 5000). Satu query per interval, berapa pun TV-nya.
POLL_MS=60000
# Sumber yang dipakai, dipisah koma: postgres, drive, sheet, jubelio
# Event 2026: warehouse we_data_store (laporan_penjualan) + Sheet brand di folder Drive
DATA_SOURCES=postgres,drive
# Vercel saja: lama /api/state di-cache di CDN (detik) = jarak minimum antar query ke database
CACHE_SECONDS=30

# --- Postgres: warehouse we_data_store, tabel laporan_penjualan ---
# Pakai user read-only. Pilih SALAH SATU cara; kalau keduanya terisi, DATABASE_URL yang dipakai.
#
# a. Variabel terpisah (disarankan): password ditulis apa adanya, tanpa encode.
#    SELALU apit dengan kutip tunggal: tanpa kutip, # dibaca sebagai komentar (Rh#4s -> "Rh").
#    Kalau password memuat kutip tunggal, pakai kutip ganda. Di Vercel tempel tanpa kutip.
DATABASE_HOST=host
DATABASE_PORT=5432
DATABASE_USER=readonly
DATABASE_PASSWORD='password'
DATABASE_NAME=we_data_store
#
# b. Satu URL: tanda baca di password harus di-encode (# -> %23, / -> %2F, ? -> %3F, @ -> %40).
#    Encode otomatis: read -rs PW && PW="$PW" node -e 'console.log(encodeURIComponent(process.env.PW))'; unset PW
#    Schema lain: tambahkan ?options=-c%20search_path%3Dnama_schema
# DATABASE_URL=postgres://readonly:password@host:5432/we_data_store
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Satu baris per invoice: phone, name, qty, value. laporan_penjualan berisi satu baris
# per produk dan total_bayar (total satu invoice) berulang di tiap baris itu, jadi
# baris dikelompokkan per invoice dan total_bayar diambil SEKALI (MAX), tidak dijumlahkan.
# Invoice yang berbeda milik nomor HP yang sama dijumlahkan oleh papan. Kolom penyaring
# event (warehouse atau channel) dan status yang dibuang dipastikan dulu dengan
# scripts/cek-event-postgres.sql.
PG_QUERY=SELECT MAX(no_hp) AS phone, MAX(nama) AS name, SUM(qty) AS qty, MAX(total_bayar) AS value FROM laporan_penjualan WHERE warehouse = 'MAIN IMPERFECT WAREHOUS 2026' AND tanggal >= DATE '2026-10-30' AND tanggal < DATE '2026-11-02' GROUP BY COALESCE(NULLIF(btrim(invoice_number), ''), no_order)

# --- Sheet brand: satu spreadsheet per brand dalam satu folder Google Drive ---
# Dibaca dengan akun layanan (service account); folder di-share ke email akun itu sebagai Viewer.
# Brand hanya di-share ke file-nya sendiri. File dibuat dengan scripts/buat-sheet-brand.gs.
# Nama file = nama brand. Dibaca tab pertama (ekspor CSV lewat Drive API): No HP, Nama, qty, trx value.
DRIVE_FOLDER=https://drive.google.com/drive/folders/ISI_ID_FOLDER
# Isi file key JSON akun layanan, satu baris (di Vercel tempel apa adanya, tandai Sensitive).
# Di .env apit dengan kutip tunggal.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Atau dua variabel (private_key boleh dengan \n literal):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=papan-tv@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# DRIVE_MAX_ROWS=5000

# --- Google Sheet dengan link publik (alternatif tanpa akun layanan) ---
# Siapa pun yang memegang link bisa melihat isinya; untuk omzet brand pakai folder Drive di atas.
# Tiap link: Share "Anyone with the link" (Viewer), ID Sheet, atau link CSV dari Publish to web.
# Kolom: No HP, Nama, qty, trx value (satu baris = satu transaksi).
#
# Sheet per brand: satu brand per baris "Brand | link" (di Vercel tempel apa adanya, multi-baris).
# Tiap brand jadi sumber sendiri: Sheet yang belum ada / gagal hanya memberi peringatan untuk brand itu.
# Di .env satu baris, pisahkan dengan titik koma.
# SHEET_URLS=Heymale | https://docs.google.com/spreadsheets/d/AAA/edit?gid=0; Heylocal | https://docs.google.com/spreadsheets/d/BBB/edit?gid=0
#
# Satu Sheet tanpa brand (opsional, bisa dipakai bersamaan dengan SHEET_URLS)
# SHEET_URL=https://docs.google.com/spreadsheets/d/1PxiUbW5nFohIkVMae8m2yd-OWzrqOcwSavEv8In6Uok/edit?gid=949297504#gid=949297504
# Tab yang dibaca bila link tidak memuat gid
SHEET_GID=0

# --- Jubelio (hanya baca: POST /login + GET) ---
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
# Boleh beberapa gudang, dipisah koma
# Event 2026 (live). Nama gudang PERSIS seperti di Jubelio (huruf besar/kecil bebas).
# Daftar order Jubelio hanya memuat nama lokasi, jadi filter selalu lewat nama.
JUBELIO_LOCATION=MAIN IMPERFECT WAREHOUS 2026
# Rentang tanggal transaksi event (WIB). Wajib diisi agar tidak menarik semua order sejak 2023
JUBELIO_DATE_FROM=2026-10-30
JUBELIO_DATE_TO=2026-11-01
# Kolom nilai belanja dari detail order: grand_total (default) atau sub_total
# JUBELIO_VALUE_FIELD=grand_total
# JUBELIO_INCLUDE_CANCELED=false
# JUBELIO_CONCURRENCY=5
# Batas waktu sinkron per pembacaan (ms), di bawah maxDuration 30 detik Vercel
# JUBELIO_BUDGET_MS=20000
